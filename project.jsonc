// jpm-publish: the `jpm publish` extension. Install with `jpm add -g github:java-package-manager/jpm-publish`.
{
  "name": "jpm-publish",
  "group": "dev.jpm",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Publish jpm projects to Maven repositories and Maven Central",
  "url": "https://github.com/java-package-manager/jpm-publish",
  "java": "21",
  "main": "dev.jpm.publish.Main",
  "repositories": ["https://repo.thenextlvl.net/snapshots"],
  "runtime": {
    // jpm's client; a timestamped snapshot until jpm 0.12.0 is released
    "dev.jpm:jpm-api": "0.11.0-20261122.163616-1"
  },
  "test": {
    "org.junit.jupiter:junit-jupiter": "5.11.4"
  }
}
