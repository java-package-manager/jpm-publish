// jpm-publish: the `jpm publish` extension. Install with `jpm add -g github:java-package-manager/jpm-publish`.
{
  "name": "jpm-publish",
  "group": "dev.jpm",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Publish jpm projects to Maven repositories and Maven Central",
  "url": "https://github.com/java-package-manager/jpm-publish",
  "java": "21",
  "main": "dev.jpm.publish.Main",
  "defineClass": "dev.jpm.publish.BuildConfig",
  // what IDEs show for `jpm publish` (jpm's extensions/list); PublishTest checks it lists every option of the help
  "extension": {
    "description": "Publish jpm modules to Maven repositories and Maven Central",
    "commands": {
      "publish": {
        "description": "Publish every module with a \"group\" to a repository from extensions.publish.repositories, or a URL",
        "options": {
          "--local": { "description": "Publish to the local Maven repository (~/.m2/repository)" },
          "--module": { "argument": "name", "description": "Publish only this module (repeatable)" },
          "--dry-run": { "description": "Build everything into .cache/publish/ and show what would be uploaded" },
          "--no-build": { "description": "Use the jars already in dist/" },
          "--no-sources": { "description": "Leave out the sources jar" },
          "--no-javadoc": { "description": "Leave out the javadoc jar" },
          "--sign": { "description": "Sign with gpg (default: on for Maven Central, off elsewhere)" },
          "--no-sign": { "description": "Do not sign" },
          "--no-wait": { "description": "Maven Central: do not wait for validation" }
        }
      }
    }
  },
  "repositories": ["https://repo.thenextlvl.net/releases"],
  "runtime": {
    // jpm's client: the jpm protocol, which jpm 0.12.0 serves
    "dev.jpm:jpm-api": "^0.12.0"
  },
  "test": {
    "org.junit.jupiter:junit-jupiter": "5.11.4"
  }
}
